NODE_ENV=development
PORT=5000
APP_NAME=money-assistant-api

MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/money_assistant?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@cluster0.mongodb.net/money_assistant_test?retryWrites=true&w=majority

JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters
JWT_ACCESS_EXPIRES_IN=365d
JWT_REFRESH_EXPIRES_IN=3650d
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

OPENAI_API=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_TOKENS=1000

PASSWORD_RESET_EXPIRES_IN=3600000
PASSWORD_RESET_SECRET=your_password_reset_secret_key

LOG_LEVEL=info

